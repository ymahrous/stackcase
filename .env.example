# Required. Postgres connection string (Neon, Supabase, Vercel Postgres...).
DATABASE_URL=

# Required in production. The site's origin; portfolios live at <this URL>/<username>.
# Example: NEXT_PUBLIC_SITE_URL=https://stackcase.vercel.app
# Production builds fail if it is missing. In development it falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Email via Resend (https://resend.com/api-keys). Without a key, development prints emails to the server log
# and production skips them. The key must be allowed to send from resend.dev (Full access, or Sending access
# for all domains).
# The sender is always Resend's default, "Stackcase <onboarding@resend.dev>". Resend only delivers mail from it
# to the email address that owns your Resend account; other recipients are rejected (logged as email.rejected).
RESEND_API_KEY=
# Optional Reply-To header on account emails. Never shown on the site.
EMAIL_REPLY_TO=

# Optional. Overrides the brand name (defaults to Stackcase).
NEXT_PUBLIC_APP_NAME=

# Legal pages (/privacy, /terms, /accessibility). Stackcase is named as the operator, the texts apply worldwide,
# and the Terms use international contract principles (see lib/legal.ts). Have a lawyer review them before launch.
# There is no contact email: people reach you through GitHub issues and private vulnerability reporting on the
# repository in lib/brand.ts, which also back /.well-known/security.txt and the "Help" link in emails.
# Your database host, named in the privacy policy, e.g. "Neon Inc. (USA)". Optional.
LEGAL_DATABASE_PROVIDER=
# How long your database provider keeps backups, in days. Defaults to 30.
LEGAL_BACKUP_RETENTION_DAYS=
