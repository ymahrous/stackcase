# Required. Postgres connection string (Neon, Supabase, Vercel Postgres...).
DATABASE_URL=

# Required in production. The site's origin; portfolios live at <this URL>/<username>.
# Example: NEXT_PUBLIC_SITE_URL=https://stackcase.vercel.app
# Production builds fail if it is missing. In development it falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Email via Resend (https://resend.com/api-keys). Without a key, development prints emails to the server log
# and production skips them.
RESEND_API_KEY=
# Sender. Must be on a domain verified in Resend to reach users. Without it, Resend's test sender
# onboarding@resend.dev is used, which only delivers to the email address that owns your Resend account.
# Example: EMAIL_FROM="Stackcase <hello@mail.your-domain.com>"
EMAIL_FROM=
# Optional reply-to address for account emails.
EMAIL_REPLY_TO=

# Optional. Overrides the brand name (defaults to Stackcase).
NEXT_PUBLIC_APP_NAME=

# Optional. Where security researchers report vulnerabilities (mailto: or https:). Enables /.well-known/security.txt
SECURITY_CONTACT=

# Legal pages (/privacy, /terms, /accessibility). Stackcase is named as the operator and the Terms use
# international contract principles (see lib/legal.ts). Have a lawyer review the texts before launch.
# Contact for privacy requests, legal notices and accessibility feedback. Falls back to EMAIL_REPLY_TO.
# Until one of them is set, the legal pages show a notice that contact details are incomplete.
# It also appears as the "Help" link in account emails.
LEGAL_CONTACT_EMAIL=
# GDPR Art. 27 / UK GDPR representatives, if you serve EU/UK users from outside the EU/UK. Optional.
LEGAL_EU_REPRESENTATIVE=
LEGAL_UK_REPRESENTATIVE=
# Your database host, named in the privacy policy, e.g. "Neon Inc. (USA)". Optional.
LEGAL_DATABASE_PROVIDER=
# How long your database provider keeps backups, in days. Defaults to 30.
LEGAL_BACKUP_RETENTION_DAYS=
